# Copie para .env e preencha. Nunca commite o .env.

# --- Provedor de LLM (obrigatório) ---
GROQ_API_KEY=

# --- Modelos e temperaturas (opcional; defaults em src/banco_agil/config.py) ---
MODELO_DIALOGO=llama-3.3-70b-versatile
MODELO_EXTRACAO=llama-3.3-70b-versatile
TEMPERATURA_DIALOGO=0.3
TEMPERATURA_EXTRACAO=0.0

# --- Parâmetros de negócio (opcional) ---
MAX_TENTATIVAS_AUTH=3
MAX_ENTREVISTAS_POR_SESSAO=1
RECURSION_LIMIT=25

# --- Câmbio (opcional) ---
COTACAO_BASE_URL=https://economia.awesomeapi.com.br/json/last
COTACAO_TIMEOUT_S=5.0
COTACAO_MAX_RETRIES=2
CAMBIO_FALLBACK_WEB=false

# --- Observabilidade (opcional) ---
LOG_LEVEL=INFO
